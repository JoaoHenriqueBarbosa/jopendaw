DATABASE_URL=postgres://jopendaw:jopendaw@localhost:5432/jopendaw
PORT=8080

# Segredo do JWT de acesso (HS256). Mínimo 32 chars: `openssl rand -base64 48`
JWT_SECRET=

# Origem pública do app web; vai no link do email (/entrar) e nos retornos do OAuth
APP_BASE_URL=http://localhost:8080

# jmail (serviço de email próprio, repo irmão /Volumes/Projects/jmail): URL e a chave do app jopendaw
JMAIL_URL=http://127.0.0.1:8790
JMAIL_API_KEY=
MAIL_FROM=no-reply@jopendaw.local
MAIL_FROM_NAME=jopendaw

# Entrar com Google e com Discord (oauth.rs): cliente e segredo de cada provedor. Sem o par, o
# botão não aparece. Os endereços de retorno registrados nos provedores são
# {APP_BASE_URL}/api/auth/oauth/google/callback e …/discord/callback; no Discord registre também
# discord-{DISCORD_CLIENT_ID}:/authorize/callback (a volta pelo app do Discord no Android).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Conta de demonstração que entra por código (revisão da Play Store): os dois ou nenhum; código
# com 24+ caracteres.
REVIEW_EMAIL=
REVIEW_CODE=

# Armazenamento dos áudios (blobs/<2 hex>/<sha256>). Sem S3_ENDPOINT vai para o disco, em DATA_DIR
# (desenvolvimento e testes). DATA_DIR também guarda os temporários de upload no modo S3. Relativo
# ao diretório de onde o servidor roda.
DATA_DIR=./data

# S3 compatível (MinIO em produção). Com S3_ENDPOINT definido os quatro primeiros são obrigatórios.
# S3_PATH_STYLE=true (padrão) é o estilo endpoint/bucket/chave do MinIO; S3_REGION padrão us-east-1.
# Local: `docker-compose up -d minio minio-init` (console em http://localhost:9001).
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=jopendaw
# S3_ACCESS_KEY=jopendaw
# S3_SECRET_KEY=jopendaw-minio-dev
# S3_REGION=us-east-1
# S3_PATH_STYLE=true
# Migrar os blobs que já estão em DATA_DIR para o bucket (idempotente, pode repetir):
#   cd server && cargo run -- migrate-blobs-to-s3
